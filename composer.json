{
  "name": "soeverse/laravel-cas",
  "description": "Native CAS Authentication package for Laravel.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "cas",
    "authentication",
    "laravel",
    "sso"
  ],
  "homepage": "https://github.com/soeverse/laravel-cas",
  "support": {
    "issues": "https://github.com/soeverse/laravel-cas/issues",
    "source": "https://github.com/soeverse/laravel-cas"
  },
  "authors": [
    {
      "name": "Soeverse",
      "email": "soeverse.tech@gmail.com"
    }
  ],
  "require": {
    "php": "^8.0",
    "illuminate/support": "^9.0|^10.0|^11.0|^12.0|^13.0",
    "illuminate/http": "^9.0|^10.0|^11.0|^12.0|^13.0"
  },
  "require-dev": {
    "orchestra/testbench": "^7.0|^8.0|^9.0|^10.0|^11.0",
    "phpunit/phpunit": "^9.6|^10.5|^11.0|^12.0"
  },
  "autoload": {
    "psr-4": {
      "Soeverse\\Cas\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Soeverse\\Cas\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Soeverse\\Cas\\CasServiceProvider"
      ],
      "aliases": {
        "Cas": "Soeverse\\Cas\\Facades\\Cas"
      }
    }
  },
  "scripts": {
    "test": "phpunit"
  }
}
